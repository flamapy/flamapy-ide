# Flamapy wheels served to the browser are build artifacts: they are
# regenerated by `make build-wheels` (versions from flamapy.version + the
# Makefile dep list) and the deploy pipelines rebuild them before bundling, so
# they are not tracked. The wheels below are manually vendored and have no
# PyPI/release-bundle source, so they MUST stay tracked.
public/flamapy/*.whl
!public/flamapy/flamapy_configurator-*.whl
!public/flamapy/z3_solver-*.whl
!public/flamapy/flamapy_sharpsat-*.whl
!public/flamapy/pyunigen-*.whl
!public/flamapy/flamapy_sdd-*.whl
!public/flamapy/pysdd-*.whl

# The served manifest carries versioned wheel filenames, so it too is a build
# artifact: `make build-wheels` generates it from the tracked, version-less
# plugins.conf.template.json. Only the template is committed.
public/flamapy/plugins.conf.json